{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "apps/api",
        "uvicorn",
        "calypr_api.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@calypr/web",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "haven-realty",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "/Users/tracey/Documents/_TRAE Projects/TFO/Templates/Real Estate Theme/haven-realty",
        "run",
        "dev",
        "--",
        "-p",
        "3210"
      ],
      "port": 3210
    }
  ]
}